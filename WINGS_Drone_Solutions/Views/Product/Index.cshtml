@model IEnumerable<WINGS.DAL.Entities.Product>

@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Products";

    var role = HttpContextAccessor.HttpContext?
        .Session.GetString("Role");

    bool isAdmin = role == "Admin";
    bool isCustomer = role == "Customer";
}

<div class="container-fluid py-4">

    <!-- ================= PAGE HEADER ================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                <i class="bi bi-box-seam-fill text-primary me-2"></i>
                Products
            </h2>

            <p class="text-muted mb-0">
                Browse and manage drone products and accessories.
            </p>

        </div>


        @if (isAdmin)
        {
            <a asp-action="Create"
               class="btn btn-primary px-4 shadow-sm">

                <i class="bi bi-plus-circle me-1"></i>
                Add Product

            </a>
        }

    </div>


    <!-- ================= PRODUCT CARD ================= -->

    <div class="card border-0 shadow-sm">

        <!-- CARD HEADER -->

        <div class="card-header bg-dark text-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">

                    <i class="bi bi-grid-3x3-gap me-2"></i>
                    Product List

                </h5>


                <span class="badge bg-light text-dark">

                    @(Model?.Count() ?? 0) Products

                </span>

            </div>

        </div>


        <!-- CARD BODY -->

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <!-- ================= TABLE HEADER ================= -->

                    <thead class="table-light">

                        <tr>

                            <th class="text-center"
                                style="width:65px;">
                                #
                            </th>

                            <th style="width:110px;">
                                Image
                            </th>

                            <th style="min-width:200px;">
                                Product
                            </th>

                            <th style="min-width:170px;">
                                Category
                            </th>

                            <th style="width:130px;">
                                Price
                            </th>

                            <th style="width:120px;">
                                Stock
                            </th>

                            <th style="width:150px;">
                                Brand
                            </th>

                            <th style="min-width:180px;">
                                Status
                            </th>

                            <th class="text-center"
                                style="min-width:280px;">

                                Actions

                            </th>

                        </tr>

                    </thead>


                    <!-- ================= TABLE BODY ================= -->

                    <tbody>

                        @if (Model != null && Model.Any())
                        {

                            foreach (var item in Model)
                            {

                                <tr>

                                    <!-- ID -->

                                    <td class="text-center">

                                        <span class="fw-semibold text-muted">

                                            @item.ProductId

                                        </span>

                                    </td>


                                    <!-- IMAGE -->

                                    <td>

                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl"
                                                 alt="@item.ProductName"
                                                 width="80"
                                                 height="80"
                                                 class="rounded-3 border shadow-sm"
                                                 style="object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-light border rounded-3
                                                d-flex align-items-center
                                                justify-content-center"
                                                 style="width:80px;height:80px;">

                                                <i class="bi bi-image text-muted fs-3">
                                                </i>

                                            </div>
                                        }

                                    </td>


                                    <!-- PRODUCT -->

                                    <td>

                                        <div class="fw-bold">

                                            @item.ProductName

                                        </div>

                                        <small class="text-muted">

                                            Product #@item.ProductId

                                        </small>

                                    </td>


                                    <!-- CATEGORY -->

                                    <td>

                                        @if (item.Category != null)
                                        {
                                            <span class="badge bg-light text-dark border">

                                                <i class="bi bi-tag me-1"></i>

                                                @item.Category.CategoryName

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <!-- PRICE -->

                                    <td>

                                        <span class="fw-bold text-success">

                                            ₹ @item.Price.ToString("N2")

                                        </span>

                                    </td>


                                    <!-- STOCK -->

                                    <td>

                                        @if (item.Stock > 10)
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-check-circle me-1"></i>

                                                @item.Stock Available

                                            </span>
                                        }
                                        else if (item.Stock > 0)
                                        {
                                            <span class="badge bg-warning text-dark">

                                                <i class="bi bi-exclamation-circle me-1"></i>

                                                @item.Stock Left

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">

                                                <i class="bi bi-x-circle me-1"></i>

                                                Out of Stock

                                            </span>
                                        }

                                    </td>


                                    <!-- BRAND -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(item.Brand))
                                        {
                                            <span class="fw-semibold">

                                                @item.Brand

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        <div class="d-flex flex-wrap gap-1">

                                            @if (item.IsFeatured)
                                            {
                                                <span class="badge bg-primary">

                                                    <i class="bi bi-star-fill me-1"></i>
                                                    Featured

                                                </span>
                                            }


                                            @if (item.IsTrending)
                                            {
                                                <span class="badge bg-warning text-dark">

                                                    <i class="bi bi-fire me-1"></i>
                                                    Trending

                                                </span>
                                            }


                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-success">

                                                    <i class="bi bi-check-circle me-1"></i>
                                                    Active

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">

                                                    <i class="bi bi-x-circle me-1"></i>
                                                    Inactive

                                                </span>
                                            }

                                        </div>

                                    </td>


                                    <!-- ACTIONS -->

                                    <td>

                                        <div class="d-flex flex-wrap
                                            justify-content-center
                                            gap-2">


                                            <!-- DETAILS -->

                                            <a asp-action="Details"
                                               asp-route-id="@item.ProductId"
                                               class="btn btn-info btn-sm text-white">

                                                <i class="bi bi-eye me-1"></i>
                                                Details

                                            </a>


                                            <!-- CUSTOMER -->
                                            @if (isCustomer && item.IsActive && item.Stock > 0)
                                            {
                                                <a asp-action="AddToCart"
                                                   asp-route-id="@item.ProductId"
                                                   class="btn btn-success btn-sm">

                                                    <i class="bi bi-cart-plus me-1"></i>
                                                    Add to Cart

                                                </a>
                                            }


                                            <!-- ADMIN -->
                                            @if (isAdmin)
                                            {

                                                <a asp-action="Edit"
                                                   asp-route-id="@item.ProductId"
                                                   class="btn btn-warning btn-sm">

                                                    <i class="bi bi-pencil-square me-1"></i>
                                                    Edit

                                                </a>


                                                <a asp-action="Delete"
                                                   asp-route-id="@item.ProductId"
                                                   class="btn btn-danger btn-sm"
                                                   onclick="return confirm('Are you sure you want to delete this product?');">

                                                    <i class="bi bi-trash me-1"></i>
                                                    Delete

                                                </a>

                                            }

                                        </div>

                                    </td>

                                </tr>

                            }

                        }
                        else
                        {

                            <!-- ================= EMPTY STATE ================= -->

                            <tr>

                                <td colspan="9"
                                    class="text-center py-5">

                                    <div class="mb-3">

                                        <i class="bi bi-box-seam text-muted"
                                           style="font-size:55px;">
                                        </i>

                                    </div>


                                    <h5 class="text-muted">

                                        No Products Found

                                    </h5>


                                    @if (isAdmin)
                                    {

                                        <p class="text-muted">

                                            Start by adding your first drone product.

                                        </p>


                                        <a asp-action="Create"
                                           class="btn btn-primary">

                                            <i class="bi bi-plus-circle me-1"></i>
                                            Add Product

                                        </a>

                                    }

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>