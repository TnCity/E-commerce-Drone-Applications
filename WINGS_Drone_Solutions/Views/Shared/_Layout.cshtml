@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var role = HttpContextAccessor.HttpContext?
        .Session.GetString("Role");
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - WINGS Drone Solutions</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">

        <div class="container">

            <a class="navbar-brand fw-bold"
               asp-controller="Home"
               asp-action="Index">

                🚁 WINGS Drone Solutions

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbarNav">

                <!-- Left Menu -->

                <ul class="navbar-nav me-auto">

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">

                            Home

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Product"
                           asp-action="Index">

                            Products

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Category"
                           asp-action="Index">

                            Categories

                        </a>

                    </li>
                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Contact">

                            Contact

                        </a>

                    </li>

                    @if (role == "Admin")
                    {
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="ContactMessage"
                               asp-action="Index">

                                Contact Messages

                            </a>

                        </li>
                    }

                </ul>

                <!-- Right Menu -->

                <ul class="navbar-nav align-items-center">

                    <!-- Cart Always Visible -->

                    <li class="nav-item me-2">

                        <a class="nav-link"
                           asp-controller="Product"
                           asp-action="Cart">

                            <i class="bi bi-cart3"></i> Cart
                        </a>

                    </li>
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Order"
                           asp-action="MyOrders">
                            My Orders
                        </a>
                    </li>

                    @if (Context.Session.GetInt32("UserId") == null)
                    {
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Login">

                                Login

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Account"
                               asp-action="Register">

                                Register

                            </a>

                        </li>
                    }
                    else
                    {
                        <li class="nav-item">

                            <span class="nav-link text-warning fw-semibold">

                                Hello,
                                @Context.Session.GetString("UserName")

                            </span>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link text-danger"
                               asp-controller="Account"
                               asp-action="Logout">

                                Logout

                            </a>

                        </li>
                    }

                </ul>

            </div>

        </div>

    </nav>

    <!-- ================= PAGE CONTENT ================= -->

    <main class="container mt-4">

        @RenderBody()

    </main>

    <!-- ================= FOOTER ================= -->

    <footer class="bg-dark text-white mt-5">

        <div class="container py-4">

            <div class="row">

                <div class="col-md-6">

                    <h5 class="fw-bold">

                        🚁 WINGS Drone Solutions

                    </h5>

                    <p class="mb-0">

                        Premium Drone Components, FPV Systems,
                        Flight Controllers & Accessories.

                    </p>

                </div>

                <div class="col-md-6 text-md-end">

                    <p class="mb-1">

                        📧 support@wingsdrone.com

                    </p>

                    <p class="mb-1">

                        📞 +91 98765 43210

                    </p>

                    <small>

                        © @DateTime.Now.Year WINGS Drone Solutions

                    </small>

                </div>

            </div>

        </div>

    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>