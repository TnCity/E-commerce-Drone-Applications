@model WINGS.Web.ViewModels.ContactViewModel

@{
    ViewData["Title"] = "Contact Us";
}

<div class="container mt-5">

    <div class="text-center mb-5">

        <h1 class="fw-bold text-primary">
            Contact WINGS Drone Solutions
        </h1>

        <p class="lead text-muted">
            We'd love to hear from you. Send us your queries anytime.
        </p>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="row">

        <!-- Contact Form -->

        <div class="col-lg-7">

            <div class="card shadow border-0 rounded-4">

                <div class="card-body p-4">

                    <h3 class="mb-4">
                        Send Message
                    </h3>

                    <form asp-controller="Home"
                          asp-action="Contact"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- Full Name -->

                        <div class="mb-3">

                            <label asp-for="FullName"
                                   class="form-label">
                                Full Name
                            </label>

                            <input asp-for="FullName"
                                   class="form-control"
                                   placeholder="Enter your name" />

                            <span asp-validation-for="FullName"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Email -->

                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label">
                                Email Address
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="Enter your email" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Phone -->

                        <div class="mb-3">

                            <label asp-for="Phone"
                                   class="form-label">
                                Phone Number
                            </label>

                            <input asp-for="Phone"
                                   class="form-control"
                                   placeholder="Enter phone number" />

                            <span asp-validation-for="Phone"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Subject -->

                        <div class="mb-3">

                            <label asp-for="Subject"
                                   class="form-label">
                                Subject
                            </label>

                            <input asp-for="Subject"
                                   class="form-control"
                                   placeholder="Enter subject" />

                            <span asp-validation-for="Subject"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Message -->

                        <div class="mb-3">

                            <label asp-for="Message"
                                   class="form-label">
                                Message
                            </label>

                            <textarea asp-for="Message"
                                      class="form-control"
                                      rows="6"
                                      placeholder="Write your message">
                            </textarea>

                            <span asp-validation-for="Message"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Submit -->

                        <button type="submit"
                                class="btn btn-primary btn-lg px-5">

                            <i class="bi bi-send"></i>
                            Send Message

                        </button>

                    </form>

                </div>

            </div>

        </div>


        <!-- Company Details -->

        <div class="col-lg-5">

            <div class="card shadow border-0 rounded-4 mb-4">

                <div class="card-body">

                    <h3 class="mb-4">
                        Contact Information
                    </h3>

                    <p>
                        📍 <strong>Address</strong><br />
                        Wings Office, Kolkata, West Bengal, India
                    </p>

                    <hr />

                    <p>
                        📞 <strong>Phone</strong><br />
                        +91 1234567890
                    </p>

                    <hr />

                    <p>
                        📧 <strong>Email</strong><br />
                        support@wingsdrone.com
                    </p>

                    <hr />

                    <p>
                        🌐 <strong>Website</strong><br />
                        www.wingsdrone.com
                    </p>

                    <hr />

                    <p>
                        🕒 <strong>Working Hours</strong><br />
                        Monday - Friday<br />
                        10:00 AM - 7:00 PM
                    </p>

                </div>

            </div>


            <!-- Google Map -->

            <div class="card shadow border-0 rounded-4">

                <div class="card-body">

                    <h4 class="mb-3">
                        Find Us
                    </h4>

                    <iframe src="https://maps.google.com/maps?q=Kolkata&t=&z=13&ie=UTF8&iwloc=&output=embed"
                            width="100%"
                            height="300"
                            style="border:0;border-radius:15px;"
                            loading="lazy">
                    </iframe>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}