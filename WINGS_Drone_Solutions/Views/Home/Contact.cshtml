@{
    ViewData["Title"] = "Contact Us";
}

<div class="container mt-5">

    <div class="text-center mb-5">

        <h1 class="fw-bold text-primary">
            Contact WINGS Drone Solutions
        </h1>

        <p class="lead text-muted">
            We'd love to hear from you. Send us your queries anytime.
        </p>

    </div>

    <div class="row">

        <!-- Contact Form -->

        <div class="col-lg-7">

            <div class="card shadow border-0 rounded-4">

                <div class="card-body p-4">

                    <h3 class="mb-4">
                        Send Message
                    </h3>

                    <form>

                        <div class="mb-3">

                            <label class="form-label">
                                Full Name
                            </label>

                            <input type="text"
                                   class="form-control"
                                   placeholder="Enter your name">

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Email Address
                            </label>

                            <input type="email"
                                   class="form-control"
                                   placeholder="Enter your email">

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Phone Number
                            </label>

                            <input type="text"
                                   class="form-control"
                                   placeholder="Enter phone number">

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Subject
                            </label>

                            <input type="text"
                                   class="form-control"
                                   placeholder="Enter subject">

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Message
                            </label>

                            <textarea class="form-control"
                                      rows="6"
                                      placeholder="Write your message"></textarea>

                        </div>

                        <button class="btn btn-primary btn-lg px-5">
                            Send Message
                        </button>

                    </form>

                </div>

            </div>

        </div>

        <!-- Company Details -->

        <div class="col-lg-5">

            <div class="card shadow border-0 rounded-4 mb-4">

                <div class="card-body">

                    <h3 class="mb-4">
                        Contact Information
                    </h3>

                    <p>
                        📍 <strong>Address</strong><br />
                        Wings Office, Kolkata, West Bengal, India
                    </p>

                    <hr />

                    <p>
                        📞 <strong>Phone</strong><br />
                        +91 1234567890
                    </p>

                    <hr />

                    <p>
                        📧 <strong>Email</strong><br />
                        support@wingsdrone.com
                    </p>

                    <hr />

                    <p>
                        🌐 <strong>Website</strong><br />
                        www.wingsdrone.com
                    </p>

                    <hr />

                    <p>
                        🕒 <strong>Working Hours</strong><br />
                        Monday - Friday<br />
                        10:00 AM - 7:00 PM
                    </p>

                </div>

            </div>

            <!-- Google Map -->

            <div class="card shadow border-0 rounded-4">

                <div class="card-body">

                    <h4 class="mb-3">
                        Find Us
                    </h4>

                    <iframe src="https://maps.google.com/maps?q=Kolkata&t=&z=13&ie=UTF8&iwloc=&output=embed"
                            width="100%"
                            height="300"
                            style="border:0;border-radius:15px;"
                            loading="lazy">
                    </iframe>

                </div>

            </div>

        </div>

    </div>

</div>