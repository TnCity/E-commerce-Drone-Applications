@model WINGS.DAL.Entities.Payment

@{
    ViewData["Title"] = "Payment Successful";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow-lg border-0 text-center">

                <div class="card-body p-5">

                    <div style="font-size:70px;">
                        ✅
                    </div>

                    <h1 class="text-success fw-bold mt-3">
                        Payment Successful!
                    </h1>

                    <p class="text-muted">
                        Your payment has been successfully processed.
                    </p>

                    <hr />


                    <div class="row text-start mt-4">

                        <div class="col-md-6 mb-3">

                            <strong>
                                Transaction ID
                            </strong>

                            <br />

                            <span class="text-primary">
                                @Model.TransactionId
                            </span>

                        </div>


                        <div class="col-md-6 mb-3">

                            <strong>
                                Payment Date
                            </strong>

                            <br />

                            @Model.PaymentDate.ToString(
                                "dd MMM yyyy, hh:mm tt")

                        </div>


                        <div class="col-md-6 mb-3">

                            <strong>
                                Payment Method
                            </strong>

                            <br />

                            @Model.PaymentMethod

                        </div>


                        <div class="col-md-6 mb-3">

                            <strong>
                                Amount
                            </strong>

                            <br />

                            <span class="text-success fw-bold">
                                ₹ @Model.Amount.ToString("N2")
                            </span>

                        </div>


                        <div class="col-md-6 mb-3">

                            <strong>
                                Payment Status
                            </strong>

                            <br />

                            <span class="badge bg-success">
                                @Model.Status
                            </span>

                        </div>


                        <div class="col-md-6 mb-3">

                            <strong>
                                Order ID
                            </strong>

                            <br />

                            #@Model.OrderId

                        </div>

                    </div>


                    <hr />


                    <div class="mt-4">

                        <a asp-controller="Order"
                           asp-action="Confirmation"
                           asp-route-id="@Model.OrderId"
                           class="btn btn-success btn-lg">

                            📦 View Order

                        </a>


                        <a asp-controller="Product"
                           asp-action="Index"
                           class="btn btn-outline-primary btn-lg">

                            Continue Shopping

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>