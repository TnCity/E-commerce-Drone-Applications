@model IEnumerable<WINGS.DAL.Entities.Category>

@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Categories";

    var role = HttpContextAccessor.HttpContext?
        .Session.GetString("Role");

    bool isAdmin = role == "Admin";
}

<div class="container-fluid py-4">

    <!-- ================= HEADER ================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-grid-3x3-gap-fill text-primary"></i>
                Categories
            </h2>

            <p class="text-muted mb-0">
                Manage drone product categories and their available products.
            </p>
        </div>

        @if (isAdmin)
        {
            <a asp-action="Create"
               class="btn btn-primary px-4 shadow-sm">

                <i class="bi bi-plus-circle me-1"></i>
                Add Category

            </a>
        }

    </div>


    <!-- ================= CATEGORY TABLE ================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-dark text-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">
                    <i class="bi bi-list-ul me-2"></i>
                    Category List
                </h5>

                <span class="badge bg-light text-dark">
                    @Model.Count() Categories
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="text-center" style="width:70px;">
                                #
                            </th>

                            <th style="width:110px;">
                                Image
                            </th>

                            <th style="width:220px;">
                                Category
                            </th>

                            <th>
                                Description
                            </th>

                            <th class="text-center" style="width:300px;">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <!-- ID -->

                                    <td class="text-center fw-semibold text-muted">

                                        @item.CategoryId

                                    </td>


                                    <!-- IMAGE -->

                                    <td>

                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl"
                                                 alt="@item.CategoryName"
                                                 width="75"
                                                 height="75"
                                                 class="rounded-3 border shadow-sm"
                                                 style="object-fit:cover;" />
                                        }
                                        else
                                        {
                                            <div class="bg-light border rounded-3 d-flex
                                                align-items-center justify-content-center"
                                                 style="width:75px;height:75px;">

                                                <i class="bi bi-image text-muted fs-3"></i>

                                            </div>
                                        }

                                    </td>


                                    <!-- CATEGORY NAME -->

                                    <td>

                                        <div class="fw-bold">

                                            @item.CategoryName

                                        </div>

                                        <small class="text-muted">
                                            Category #@item.CategoryId
                                        </small>

                                    </td>


                                    <!-- DESCRIPTION -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <span class="text-muted">

                                                @item.Description

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">

                                                No description available

                                            </span>
                                        }

                                    </td>


                                    <!-- ACTIONS -->

                                    <td class="text-center">

                                        <div class="d-flex flex-wrap
                                            justify-content-center gap-2">


                                            <!-- VIEW PRODUCTS -->

                                            <a asp-action="ViewAvailables"
                                               asp-route-id="@item.CategoryId"
                                               class="btn btn-info btn-sm text-white">

                                                <i class="bi bi-box-seam me-1"></i>
                                                Products

                                            </a>


                                            @if (isAdmin)
                                            {

                                                <!-- EDIT -->

                                                <a asp-action="Edit"
                                                   asp-route-id="@item.CategoryId"
                                                   class="btn btn-warning btn-sm">

                                                    <i class="bi bi-pencil-square me-1"></i>
                                                    Edit

                                                </a>


                                                <!-- DELETE -->

                                                <a asp-action="Delete"
                                                   asp-route-id="@item.CategoryId"
                                                   class="btn btn-danger btn-sm"
                                                   onclick="return confirm('Are you sure you want to delete this category?');">

                                                    <i class="bi bi-trash me-1"></i>
                                                    Delete

                                                </a>

                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <!-- EMPTY STATE -->

                            <tr>

                                <td colspan="5"
                                    class="text-center py-5">

                                    <div class="mb-3">

                                        <i class="bi bi-folder-x text-muted"
                                           style="font-size:50px;">
                                        </i>

                                    </div>

                                    <h5 class="text-muted">
                                        No Categories Found
                                    </h5>

                                    @if (isAdmin)
                                    {
                                        <p class="text-muted mb-3">
                                            Start by creating your first product category.
                                        </p>

                                        <a asp-action="Create"
                                           class="btn btn-primary">

                                            <i class="bi bi-plus-circle me-1"></i>
                                            Add Category

                                        </a>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>